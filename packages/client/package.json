{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "cross-env CLIENT_MODE=ssr nodemon --project=tsconfig.ssr-server.json ./ssr-server/index.ts",
    "build": "tsc && vite build --outDir dist/app-csr-client-bundle",
    "build:ssr": "yarn build:ssr:app-client-bundle && yarn build:ssr:app-server-bundle && yarn build:ssr:server",
    "build:ssr:app-client-bundle": "tsc && cross-env CLIENT_MODE=ssr vite build --outDir dist/app-ssr-client-bundle",
    "build:ssr:app-server-bundle": "tsc && cross-env CLIENT_MODE=ssr vite build --ssr src/ssr.server-entry.tsx --outDir dist/app-ssr-server-bundle",
    "build:ssr:server": "tsc --p ./tsconfig.ssr-server.json",
    "preview": "vite preview --outDir dist/app-csr-client-bundle",
    "preview:ssr": "cross-env NODE_ENV=production node ./dist/ssr-server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest ./",
    "generate-api": "ts-node --project=tsconfig.node.json ./api/codegen.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@reduxjs/toolkit": "^2.8.2",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.60.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.3",
    "sirv": "^3.0.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.2.0",
    "@rtk-query/codegen-openapi": "^2.0.0",
    "@testing-library/react": "^13.3.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^28.1.8",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^5.35.1",
    "@typescript-eslint/parser": "^5.35.1",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.0.2",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^28",
    "jest-environment-jsdom": "^29.0.1",
    "jest-transform-stub": "^2.0.0",
    "nodemon": "^3.1.10",
    "sass": "^1.89.2",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.9.2",
    "vite": "^7.0.6"
  },
  "license": "MIT"
}
