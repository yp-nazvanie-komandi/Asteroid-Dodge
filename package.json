{
  "name": "asteroid-dodge",
  "private": true,
  "scripts": {
    "bootstrap": "yarn && node init.js",
    "build": "lerna run build",
    "build:server": "lerna run build --scope=server",
    "build:ssr": "lerna run build:ssr --scope=client",
    "dev:client": "lerna run dev --scope=client",
    "dev:client:ssr": "lerna run dev:ssr --scope=client",
    "dev:server": "lerna run dev --scope=server",
    "preview:ssr": "lerna run preview:ssr --scope=client",
    "dev": "lerna run dev",
    "test": "lerna run test",
    "lint": "lerna run lint",
    "format": "lerna run format",
    "preview": "lerna run preview",
    "commit": "cz",
    "generate-api": "lerna run generate-api --scope=client"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@evilmartians/lefthook": "^1.11.16",
    "commitizen": "^4.3.1",
    "typescript": "^5.8.3",
    "lerna": "^8.2.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
